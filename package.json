{
  "name": "extension-dev-template",
  "description": "WXT browser extension library and dev template: authenticated downloads, side-panel behavior, and persistent dev profiles",
  "version": "0.3.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "wxt prepare && vitest run",
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepublishOnly": "pnpm run build:lib && pnpm vitest run lib/__tests__/package-build.test.ts"
  },
  "peerDependencies": {
    "wxt": ">=0.20.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@wxt-dev/module-react": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "happy-dom": "^20.10.6",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-intl": "^10.1.26",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
